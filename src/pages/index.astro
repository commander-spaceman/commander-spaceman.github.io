---
import Layout from '../layouts/Layout.astro';
---

<Layout title="cmdr.blog">
	<section class="flex-1 flex items-center justify-center overflow-x-auto">
		<div class="flex flex-col items-center gap-6">
			<pre id="ascii-art" class="font-mono text-[1.3125rem] leading-tight">         ██                  ██
 ▀▀█▄ ▄████      ▀▀█▄ ▄█▀▀▀ ▀██▀▀ ████▄  ▀▀█▄
▄█▀██ ██ ██     ▄█▀██ ▀███▄  ██   ██ ▀▀ ▄█▀██
▀█▄██ ▀████     ▀█▄██ ▄▄▄█▀  ██   ██    ▀█▄██</pre>
			<pre class="font-mono text-[0.4375rem] leading-tight text-black dark:text-white">              ██                                    ██                         ██  ██
██   ██ ▄█▀█▄ ██ ▄████ ▄███▄ ███▄███▄ ▄█▀█▄    ▀▀█▄ ████▄ ▄███▄  ▀▀█▄ ████▄ ▄████  ██
██ █ ██ ██▄█▀ ██ ██    ██ ██ ██ ██ ██ ██▄█▀   ▄█▀██ ██ ██ ██ ██ ▄█▀██ ██ ▀▀ ██ ██  ▀▀
 ██▀██  ▀█▄▄▄ ██ ▀████ ▀███▀ ██ ██ ██ ▀█▄▄▄   ▀█▄██ ████▀ ▀███▀ ▀█▄██ ██    ▀████  ██</pre>
		</div>
	</section>
</Layout>

<style is:global>
	@keyframes color-cycle {
		0%, 100% { color: #f87171; }
		25% { color: #facc15; }
		50% { color: #34d399; }
		75% { color: #60a5fa; }
	}
	#ascii-art span {
		animation: color-cycle 3s infinite;
	}
</style>

<script>
	const pre = document.getElementById('ascii-art');
	if (pre) {
		const lines = (pre.textContent || '').split('\n');
		let html = '';
		for (const line of lines) {
			for (let col = 0; col < line.length; col++) {
				const char = line[col];
				if (char !== ' ') {
					html += `<span style="animation-delay:${col * 30}ms">${char}</span>`;
				} else {
					html += char;
				}
			}
			html += '\n';
		}
		pre.innerHTML = html;
	}
</script>
