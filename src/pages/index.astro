---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../consts';
---

<Layout title={SITE_TITLE}>
	<section class="flex-1 flex items-center justify-center overflow-x-auto">
		<div class="flex flex-col items-center gap-4 sm:gap-6">
			<pre id="ascii-art" class="font-mono text-[0.55rem] sm:text-[1.3125rem] leading-tight">         ██                  ██
 ▀▀█▄ ▄████      ▀▀█▄ ▄█▀▀▀ ▀██▀▀ ████▄  ▀▀█▄
▄█▀██ ██ ██     ▄█▀██ ▀███▄  ██   ██ ▀▀ ▄█▀██
▀█▄██ ▀████     ▀█▄██ ▄▄▄█▀  ██   ██    ▀█▄██</pre>
			<p class="sm:hidden text-xs opacity-40">welcome aboard</p>
			<pre class="hidden sm:block font-mono text-[0.4375rem] leading-tight text-[var(--ef-fg)]">              ██                                    ██                         ██  ██
██   ██ ▄█▀█▄ ██ ▄████ ▄███▄ ███▄███▄ ▄█▀█▄    ▀▀█▄ ████▄ ▄███▄  ▀▀█▄ ████▄ ▄████  ██
██ █ ██ ██▄█▀ ██ ██    ██ ██ ██ ██ ██ ██▄█▀   ▄█▀██ ██ ██ ██ ██ ▄█▀██ ██ ▀▀ ██ ██  ▀▀
 ██▀██  ▀█▄▄▄ ██ ▀████ ▀███▀ ██ ██ ██ ▀█▄▄▄   ▀█▄██ ████▀ ▀███▀ ▀█▄██ ██    ▀████  ██</pre>
		</div>
	</section>
</Layout>

<style is:global>
	@keyframes color-cycle {
		0%, 100% { color: var(--ef-red); }
		25% { color: var(--ef-yellow); }
		50% { color: var(--ef-green); }
		75% { color: var(--ef-blue); }
	}
	#ascii-art span {
		animation: color-cycle 3s infinite;
	}
</style>

<script>
	const pre = document.getElementById('ascii-art');
	if (pre) {
		const lines = (pre.textContent || '').split('\n');
		let html = '';
		for (const line of lines) {
			for (let col = 0; col < line.length; col++) {
				const char = line[col];
				if (char !== ' ') {
					html += `<span style="animation-delay:${col * 30}ms">${char}</span>`;
				} else {
					html += char;
				}
			}
			html += '\n';
		}
		pre.innerHTML = html;
	}
</script>
