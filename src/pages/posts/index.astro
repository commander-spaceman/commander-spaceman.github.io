---
import Layout from '../../layouts/Layout.astro';
import ArrowLink from '../../components/ArrowLink.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title={`Posts - ${SITE_TITLE}`}>
	<h1 class="text-2xl font-bold mb-8">Posts</h1>
	<ul class="flex flex-col gap-4">
		{posts.map((post) => (
			<li>
				<a href={`/posts/${post.id}`} class="block no-underline border border-[var(--ef-border)] rounded-lg p-5 bg-[var(--ef-bg-card)] hover:bg-[var(--ef-bg-hover)] transition-colors group flex items-center justify-between gap-4">
					<div>
						<h2 class="text-base font-semibold">{post.data.title}</h2>
						<div class="mt-4 opacity-50">
							<time class="text-xs" datetime={post.data.pubDate.toISOString()}>
								{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
							</time>
						</div>
						<p class="text-sm opacity-60 mt-4">{post.data.description}</p>
					</div>
					<ArrowLink label="Read" size="size-5" />
				</a>
			</li>
		))}
	</ul>
</Layout>
