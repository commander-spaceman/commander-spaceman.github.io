---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} - cmdr.blog`} description={post.data.description}>
	<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Posts', href: '/posts' }, { label: post.data.title }]} />
	<article>
		<header class="mb-8">
			<time class="text-sm opacity-50" datetime={post.data.pubDate.toISOString()}>
				{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
			</time>
			<h1 class="text-3xl font-bold mt-1">{post.data.title}</h1>
		</header>
		<div class="prose max-w-none">
			<Content />
		</div>
	</article>
</Layout>
