---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Layout title={`${project.data.title} - cmdr.blog`} description={project.data.description}>
	<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Projects', href: '/projects' }, { label: project.data.title }]} />
	<article>
		<header class="mb-8">
			<h1 class="text-3xl font-bold">{project.data.title}</h1>
			{project.data.url && (
				<a href={project.data.url} target="_blank" class="text-sm opacity-50 hover:opacity-100 transition-opacity">{project.data.url}</a>
			)}
			<div class="flex gap-2 mt-3">
				{project.data.tags.map((tag) => (
					<span class="text-xs opacity-50 border border-gray-300 dark:border-gray-700 rounded-full px-2 py-0.5">{tag}</span>
				))}
			</div>
		</header>
		<div class="prose dark:prose-invert max-w-none">
			<Content />
		</div>
	</article>
</Layout>
