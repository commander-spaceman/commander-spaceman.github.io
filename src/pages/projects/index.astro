---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const allProjects = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featured = allProjects.filter((p) => p.data.featured);
const others = allProjects.filter((p) => !p.data.featured);

const statusStyles = {
	active: 'bg-[var(--ef-bg-green)] text-[var(--ef-green)]',
	completed: 'bg-[var(--ef-bg-blue)] text-[var(--ef-blue)]',
	archived: 'bg-[var(--ef-bg-dim)] text-[var(--ef-muted)]',
};
---

<Layout title="Projects - cmdr.blog">
	<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Projects' }]} />
	<h1 class="text-2xl font-bold mb-8">Projects</h1>

	{featured.length > 0 && (
		<section>
			<h2 class="text-sm font-semibold uppercase tracking-wider opacity-50 mb-4">Featured</h2>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
				{featured.map((project) => (
					<a href={`/projects/${project.id}`} class="block no-underline bg-[var(--ef-bg-card)] rounded-lg border border-[var(--ef-border)] shadow-sm overflow-hidden group">
						{project.data.image && (
							<img src={project.data.image} alt="" class="w-full h-40 object-cover" />
						)}
						<div class="p-4 flex flex-col gap-3">
							<div class="flex items-start justify-between gap-2">
								<h3 class="text-sm font-bold">{project.data.title}</h3>
								<span class={`text-[10px] font-medium uppercase tracking-wider rounded-full px-2 py-0.5 shrink-0 ${statusStyles[project.data.status]}`}>{project.data.status}</span>
							</div>
							<p class="text-xs opacity-60 line-clamp-2">{project.data.description}</p>
							<div class="flex flex-wrap gap-1.5">
								{project.data.tags.map((tag) => (
									<span class="text-[10px] opacity-50 border border-[var(--ef-border)] rounded-full px-2 py-0.5">{tag}</span>
								))}
							</div>
							<div class="flex items-center justify-end gap-2 pt-1">
								<span class="text-xs font-medium opacity-70 group-hover:opacity-100 transition-opacity">Explore</span>
								<div class="relative size-4 shrink-0">
									<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="absolute inset-0 size-4 opacity-30 scale-100 group-hover:opacity-0 group-hover:scale-0 transition-all duration-300">
										<path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
									</svg>
									<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="absolute inset-0 size-4 opacity-0 scale-0 group-hover:opacity-100 group-hover:scale-100 transition-all duration-300">
										<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
									</svg>
								</div>
							</div>
						</div>
					</a>
				))}
			</div>
		</section>
	)}

	{featured.length > 0 && others.length > 0 && (
		<hr class="my-10 border-[var(--ef-border)]" />
	)}

	{others.length > 0 && (
		<section>
			<h2 class="text-sm font-semibold uppercase tracking-wider opacity-50 mb-4">Keep looking</h2>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
				{others.map((project) => (
					<a href={`/projects/${project.id}`} class="block no-underline bg-[var(--ef-bg-card)] rounded-lg border border-[var(--ef-border)] shadow-sm overflow-hidden group">
						{project.data.image && (
							<img src={project.data.image} alt="" class="w-full h-40 object-cover" />
						)}
						<div class="p-4 flex flex-col gap-3">
							<div class="flex items-start justify-between gap-2">
								<h3 class="text-sm font-bold">{project.data.title}</h3>
								<span class={`text-[10px] font-medium uppercase tracking-wider rounded-full px-2 py-0.5 shrink-0 ${statusStyles[project.data.status]}`}>{project.data.status}</span>
							</div>
							<p class="text-xs opacity-60 line-clamp-2">{project.data.description}</p>
							<div class="flex flex-wrap gap-1.5">
								{project.data.tags.map((tag) => (
									<span class="text-[10px] opacity-50 border border-[var(--ef-border)] rounded-full px-2 py-0.5">{tag}</span>
								))}
							</div>
							<div class="flex items-center justify-end gap-2 pt-1">
								<span class="text-xs font-medium opacity-70 group-hover:opacity-100 transition-opacity">Explore</span>
								<div class="relative size-4 shrink-0">
									<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="absolute inset-0 size-4 opacity-30 scale-100 group-hover:opacity-0 group-hover:scale-0 transition-all duration-300">
										<path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
									</svg>
									<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="absolute inset-0 size-4 opacity-0 scale-0 group-hover:opacity-100 group-hover:scale-100 transition-all duration-300">
										<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
									</svg>
								</div>
							</div>
						</div>
					</a>
				))}
			</div>
		</section>
	)}
</Layout>
