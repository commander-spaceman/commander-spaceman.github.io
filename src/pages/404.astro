---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE } from '../consts';
---

<Layout title={`404 - ${SITE_TITLE}`}>
	<section class="flex-1 flex flex-col items-center justify-center text-center">
		<h1 class="text-6xl font-bold opacity-20">404</h1>
		<p class="mt-4 opacity-60">This page doesn't exist in any known relay network.</p>
		<a href="/" class="mt-6 text-sm underline opacity-70 hover:opacity-100 transition-opacity">Back to home</a>
	</section>
</Layout>
