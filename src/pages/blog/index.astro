---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Layout title="Blog - cmdr.blog">
	<Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Blog' }]} />
	<h1 class="text-2xl font-bold mb-8">Blog</h1>
	<ul class="flex flex-col gap-4">
		{posts.map((post) => (
			<li>
				<a href={`/blog/${post.id}`} class="block no-underline border border-gray-200 dark:border-gray-800 rounded-lg p-5 bg-gray-50 dark:bg-gray-900 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors group flex items-center justify-between gap-4">
					<div>
						<h2 class="text-base font-semibold">{post.data.title}</h2>
						<div class="mt-4 opacity-50">
							<time class="text-xs" datetime={post.data.pubDate.toISOString()}>
								{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
							</time>
						</div>
						<p class="text-sm opacity-60 mt-4">{post.data.description}</p>
					</div>
					<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5 shrink-0 opacity-30 group-hover:opacity-100 transition-opacity">
						<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
					</svg>
				</a>
			</li>
		))}
	</ul>
</Layout>
