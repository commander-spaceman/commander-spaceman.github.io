---
interface Props {
	label: string;
	size?: string;
}

const { label, size = 'size-4' } = Astro.props;
---

<div class="flex items-center justify-end gap-2 pt-1">
	<span class="text-xs font-medium opacity-70 group-hover:opacity-100 transition-opacity">{label}</span>
	<div class={`relative ${size} shrink-0`}>
		<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class={`absolute inset-0 ${size} opacity-30 scale-100 group-hover:opacity-0 group-hover:scale-0 transition-all duration-300`}>
			<path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
		</svg>
		<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class={`absolute inset-0 ${size} opacity-0 scale-0 group-hover:opacity-100 group-hover:scale-100 transition-all duration-300`}>
			<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
		</svg>
	</div>
</div>
