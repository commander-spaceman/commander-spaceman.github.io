---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).map((post) => ({
	title: post.data.title,
	description: post.data.description,
	slug: post.id,
}));
---

<div id="search-modal" class="fixed inset-0 z-50 hidden">
	<div id="search-backdrop" class="absolute inset-0 bg-black/50"></div>
	<div class="relative flex items-start justify-center pt-24 px-4">
		<div class="bg-white dark:bg-gray-900 rounded-lg border border-gray-200 dark:border-gray-800 w-full max-w-lg shadow-lg">
			<input type="text" id="search-input" placeholder="Search posts..." class="w-full bg-transparent p-4 text-sm outline-none" autocomplete="off" />
			<div id="search-results" class="hidden border-t border-gray-200 dark:border-gray-800 max-h-64 overflow-y-auto"></div>
		</div>
	</div>
</div>

<style is:global>
	#search-results mark {
		background-color: #facc15;
		color: inherit;
		border-radius: 2px;
		padding: 0 2px;
	}
	.dark #search-results mark {
		background-color: #854d0e;
	}
</style>

<script is:inline define:vars={{ posts }}>
	var modal = document.getElementById('search-modal');
	var input = document.getElementById('search-input');
	var results = document.getElementById('search-results');

	function escapeRegex(str) {
		return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
	}

	function highlight(text, query) {
		if (!query) return text;
		var regex = new RegExp('(' + escapeRegex(query) + ')', 'gi');
		return text.replace(regex, '<mark>$1</mark>');
	}

	function open() {
		modal.classList.remove('hidden');
		document.body.classList.add('overflow-hidden');
		input.value = '';
		results.classList.add('hidden');
		results.innerHTML = '';
		input.focus();
	}

	function close() {
		modal.classList.add('hidden');
		document.body.classList.remove('overflow-hidden');
	}

	function render(query) {
		if (!query.trim()) {
			results.classList.add('hidden');
			results.innerHTML = '';
			return;
		}

		var q = query.toLowerCase();
		var filtered = posts.filter(function (p) {
			return p.title.toLowerCase().includes(q) || p.description.toLowerCase().includes(q);
		});

		results.classList.remove('hidden');

		if (filtered.length === 0) {
			results.innerHTML = '<div class="p-4 text-sm opacity-50">No results found.</div>';
			return;
		}

		results.innerHTML = filtered.map(function (p) {
			return '<a href="/blog/' + p.slug + '" class="block p-4 hover:bg-gray-50 dark:hover:bg-gray-800 no-underline transition-colors">' +
				'<div class="text-sm font-semibold">' + highlight(p.title, query) + '</div>' +
				'<div class="opacity-60 text-xs mt-1">' + highlight(p.description, query) + '</div>' +
				'</a>';
		}).join('');
	}

	document.getElementById('search-btn').addEventListener('click', open);
	document.getElementById('search-backdrop').addEventListener('click', close);

	document.addEventListener('keydown', function (e) {
		if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
			e.preventDefault();
			open();
		}
		if (e.key === 'Escape') close();
	});

	input.addEventListener('input', function () {
		render(input.value);
	});
</script>
