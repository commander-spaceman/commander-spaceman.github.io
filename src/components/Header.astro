---
---

<header>
	<nav class="container mx-auto max-w-3xl px-6 py-4 flex items-center justify-between border-b border-gray-200 dark:border-gray-800">
		<a href="/" id="logo" class="font-bold no-underline h-9 inline-flex items-center" style="font-family: var(--font-logo); font-size: var(--font-logo-size)">cmdr</a>
		<div class="flex items-center gap-6">
			<a href="/blog" class="text-sm opacity-70 hover:opacity-100 no-underline transition-opacity">blog</a>
			<a href="/projects" class="text-sm opacity-70 hover:opacity-100 no-underline transition-opacity">projects</a>
			<button id="search-btn" class="opacity-70 hover:opacity-100 transition-opacity cursor-pointer" aria-label="Search">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
					<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
				</svg>
			</button>
		</div>
	</nav>
</header>

<script>
	document.getElementById('logo')?.addEventListener('contextmenu', (e) => {
		e.preventDefault();
		const fonts = [
			{ f: '"Google Sans Code", sans-serif', s: '1.5rem' },
			{ f: '"Micro 5", sans-serif', s: '2.25rem' },
			{ f: '"Jacquard 12", sans-serif', s: '1.75rem' },
		];
		let index = parseInt(localStorage.getItem('logoFont') || '0');
		index = (index + 1) % fonts.length;
		localStorage.setItem('logoFont', index.toString());
		document.documentElement.style.setProperty('--font-logo', fonts[index].f);
		document.documentElement.style.setProperty('--font-logo-size', fonts[index].s);
	});
</script>
