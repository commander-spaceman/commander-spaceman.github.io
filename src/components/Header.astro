---
const isHome = Astro.url.pathname === '/';
---

<header>
	<nav class="container mx-auto max-w-3xl px-6 py-4 flex items-center justify-between border-b border-[var(--ef-border)]">
		<a href="/" class={`font-bold no-underline h-9 inline-flex items-center ${isHome ? 'font-pixel text-4xl' : 'text-2xl'}`}>cmdr</a>
		<div class="flex items-center gap-6">
			<a href="/blog" class="text-sm opacity-70 hover:opacity-100 no-underline transition-opacity">blog</a>
			<a href="/projects" class="text-sm opacity-70 hover:opacity-100 no-underline transition-opacity">projects</a>
			<button id="search-btn" class="opacity-70 hover:opacity-100 transition-opacity cursor-pointer" aria-label="Search">
				<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5">
					<path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
				</svg>
			</button>
		</div>
	</nav>
</header>
