---
import { SITE_TITLE } from '../consts';
---

<header class="border-b border-base-300">
	<nav class="container mx-auto max-w-4xl px-6 py-4 flex items-center justify-between">
		<a href="/" class="font-display text-2xl no-underline">{SITE_TITLE}</a>
		<div class="flex items-center gap-6">
			<a href="/blog" class="text-sm opacity-70 hover:opacity-100 no-underline transition-opacity">blog</a>
			<a href="/projects" class="text-sm opacity-70 hover:opacity-100 no-underline transition-opacity">projects</a>
			<button id="theme-toggle" class="opacity-70 hover:opacity-100 transition-opacity cursor-pointer" aria-label="Toggle theme">
				<svg class="icon-light size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
				</svg>
				<svg class="icon-dark size-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
				</svg>
			</button>
		</div>
	</nav>
</header>

<style is:global>
	html[data-theme="dark"] .icon-light { display: none; }
	html[data-theme="light"] .icon-dark { display: none; }
	html:not([data-theme]) .icon-dark { display: none; }
</style>

<script>
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const html = document.documentElement;
		const current = html.getAttribute('data-theme');
		const next = current === 'dark' ? 'light' : 'dark';
		html.setAttribute('data-theme', next);
		localStorage.setItem('theme', next);
	});
</script>
