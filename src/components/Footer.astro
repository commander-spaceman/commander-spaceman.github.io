---
---

<footer class="text-sm">
	<div class="container mx-auto max-w-3xl px-6 border-t border-[var(--ef-border)] py-6 relative flex items-center justify-center">
		<p class="opacity-50">Built with ❤ with <a href="https://astro.build" target="_blank" class="underline hover:opacity-100 transition-opacity">Astro</a> • Color scheme based on <a href="https://github.com/sainnhe/everforest" target="_blank" class="underline hover:opacity-100 transition-opacity">Everforest Soft</a></p>
		<button id="theme-toggle" class="absolute right-6 size-5 opacity-50 hover:opacity-100 transition-opacity cursor-pointer" aria-label="Toggle theme">
			<svg class="icon-light absolute inset-0 size-5 transition-all duration-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
			</svg>
			<svg class="icon-dark absolute inset-0 size-5 transition-all duration-300" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0 1 18 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 0 0 3 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 0 0 9.002-5.998Z" />
			</svg>
		</button>
	</div>
</footer>

<style is:global>
	.icon-light, .icon-dark {
		opacity: 0;
		transform: scale(0);
	}
	:root:not(.dark) .icon-light {
		opacity: 1;
		transform: scale(1);
	}
	:root.dark .icon-dark {
		opacity: 1;
		transform: scale(1);
	}
</style>

<script>
	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const html = document.documentElement;
		html.classList.toggle('dark');
		const isDark = html.classList.contains('dark');
		localStorage.setItem('theme', isDark ? 'dark' : 'light');
		if (window.setFavicon) window.setFavicon(isDark);
	});
</script>
